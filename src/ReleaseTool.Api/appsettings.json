{
  "Serilog": {
    // Named explicitly rather than left to assembly scanning, which silently
    // finds nothing when the entry assembly is not this app (test host, and
    // single-file or trimmed publishes).
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/releasetool-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Atlassian": {
    // Your Atlassian site. On the API-token route this is the site itself, not
    // the api.atlassian.com gateway, so no cloud ID is involved.
    "BaseUrl": "https://your-domain.atlassian.net/",
    // Pre-fills the space field in the UI. Point it at a sandbox space while you
    // are still validating, so a careless Load cannot reach a live release page.
    "DefaultSpaceKey": "",
    // The Jira project this tool acts on. Rows for any other project on the
    // Approvals table are left alone.
    "TicketKeyPrefix": "PROJECT",
    // Written into Developer Assigned when a ticket has no PR comment and no
    // "fixed on" reference. Resolved to an account ID at runtime.
    "FallbackDeveloperName": "",
    // Matched against the transitions the PROJECT workflow offers, so these have to
    // read exactly as the workflow spells them. Change them here if it is renamed.
    "DeployedToProductionStatus": "YOUR_DEPLOYED_STATUS",
    "ReadyForDeploymentStatus": "YOUR_READY_STATUS",
    // Checked against the resolutions the transition screen offers, and named in
    // the failure when it is not one of them.
    "ResolutionName": "Done"
  },
  // Listed here so the keys are discoverable - LEAVE THEM EMPTY. This file
  // SHIPS: it is source-controlled and it is copied into the publish output, so
  // a token here travels to everyone you hand the app to. Put yours in
  // appsettings.Local.json beside this file (gitignored, never published), or:
  //   dotnet user-secrets set "Credentials:AtlassianApiToken" "<token>"   (dev only)
  //   Credentials__AtlassianApiToken=<token>                             (environment variable)
  // A publish fails outright if these are filled in - see GuardPublishedSecrets
  // in the csproj.
  "Credentials": {
    "AtlassianEmail": "",
    "AtlassianApiToken": "",
    "DevOpsPersonalAccessToken": ""
  },
  // Where the published app listens. Overridden by --urls or ASPNETCORE_URLS,
  // and ignored in development, where launchSettings.json decides.
  "Urls": "http://localhost:5000",
  "AllowedHosts": "*"
}
